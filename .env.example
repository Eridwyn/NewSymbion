# Symbion Configuration Example
# Copy this file to .env and replace with your actual secrets

# =====================================================
# CRITICAL SECURITY SETTINGS
# =====================================================

# API Key pour authentification des requêtes (32+ bytes hex)
# Générer avec: openssl rand -hex 32
SYMBION_API_KEY=your_api_key_here_generate_with_openssl_rand_hex_32

# JWT Secret pour signature des tokens (64+ bytes hex)
# Générer avec: openssl rand -hex 64
SYMBION_JWT_SECRET=your_jwt_secret_here_generate_with_openssl_rand_hex_64

# MQTT Broker address
SYMBION_MQTT_BROKER=127.0.0.1:1883

# =====================================================
# OPTIONAL SETTINGS
# =====================================================

# HTTP Server port (default: 8080)
# SYMBION_HTTP_PORT=8080

# MQTT WebSocket port for dashboard (default: 9001)
# SYMBION_MQTT_WS_PORT=9001

# Token expiry in hours (default: 8)
# SYMBION_TOKEN_EXPIRY_HOURS=8

# =====================================================
# DEVELOPMENT ONLY (remove in production)
# =====================================================

# Disable HTTPS requirement (insecure!)
# SYMBION_ALLOW_HTTP=true

# Enable debug logging
# RUST_LOG=debug
