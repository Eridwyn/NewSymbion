# Symbion Development Environment - EXAMPLE
# Copy this file to .env and fill in your actual secrets

# JWT Secret - Generate with: openssl rand -hex 64
# Must be 128 hexadecimal characters (64 bytes)
SYMBION_JWT_SECRET=your_jwt_secret_here_128_hex_characters_min

# API Key - Generate with: openssl rand -hex 32
# Must be 64 hexadecimal characters (32 bytes)
SYMBION_API_KEY=your_api_key_here_64_hex_characters_min

# MQTT Broker address (default: localhost:1883)
SYMBION_MQTT_BROKER=127.0.0.1:1883

# JWT Token expiry in hours (default: 8 hours)
SYMBION_TOKEN_EXPIRY_HOURS=8

# TLS Certificate paths (optional - defaults to /etc/mosquitto/certs/)
# SYMBION_TLS_CERT_PATH=/path/to/cert.pem
# SYMBION_TLS_KEY_PATH=/path/to/key.pem

# Security Best Practices:
# 1. NEVER commit the actual .env file to version control
# 2. Rotate secrets every 90 days minimum
# 3. Use strong cryptographically random secrets (openssl rand)
# 4. Keep .env file permissions restrictive (chmod 600)
# 5. Use different secrets for dev/staging/production environments
