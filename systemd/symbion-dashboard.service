[Unit]
Description=Symbion Dashboard - PWA Interface Web
Documentation=https://github.com/Eridwyn/NewSymbion
After=network-online.target symbion-kernel.service
Wants=network-online.target
# Dashboard peut fonctionner sans kernel mais recommandé ensemble
BindsTo=symbion-kernel.service

[Service]
Type=simple
User=eridwyn
Group=eridwyn
# Racine du projet PWA (vite lit vite.config.js + node_modules + dist/)
WorkingDirectory=/home/eridwyn/RustroverProjects/NewSymbion/pwa-dashboard

# Sert le build de production via vite preview sur le port 3001 (HTTPS hérité
# de server.https dans vite.config.js — certs mkcert). nginx proxifie / -> 3001.
# PATH requis car le shebang de vite est `#!/usr/bin/env node`.
Environment=PATH=/usr/bin:/usr/local/bin
ExecStart=/home/eridwyn/RustroverProjects/NewSymbion/pwa-dashboard/node_modules/.bin/vite preview --host 0.0.0.0 --port 3001

# Restart automatique sur crash
Restart=always
RestartSec=10s

# Limites de ressources (node + vite preview)
MemoryMax=512M

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=symbion-dashboard

# Sécurité
NoNewPrivileges=true
PrivateTmp=true
ReadOnlyPaths=/etc /usr

[Install]
WantedBy=multi-user.target
