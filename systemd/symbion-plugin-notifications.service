[Unit]
Description=Symbion Notifications Plugin
Documentation=https://github.com/Eridwyn/NewSymbion
After=symbion-kernel.service
Requires=symbion-kernel.service

[Service]
Type=simple
User=eridwyn
WorkingDirectory=/home/eridwyn/RustroverProjects/NewSymbion
Environment="SYMBION_MQTT_BROKER=127.0.0.1:1883"
ExecStart=/bin/bash -c 'source ~/.cargo/env && ./target/release/symbion-plugin-notifications'
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=symbion-plugin-notifications

[Install]
WantedBy=default.target
