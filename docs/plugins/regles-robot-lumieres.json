  "auto_lum_absence": {
    "id": "auto_lum_absence",
    "name": "🌙 Personne à la maison : tout éteindre",
    "description": "DÉSACTIVÉE jusqu'à ce que TOUS les téléphones de la maison soient déclarés dans le plugin freebox (widget Freebox → ⚙️ Gérer). Le 15/10/2026 un seul l'était : dès que le porteur sortait, « personne à la maison » devenait vrai alors que sa compagne était là, et les lumières s'éteignaient toutes les 5 minutes — la durée du cooldown. Quatre conditions : personne à la maison, absence SOUTENUE (10 min, pour qu'un Wi-Fi qui décroche n'éteigne pas la maison), au moins une lampe joignable allumée, et le robot pas en nettoyage.",
    "category": "maison",
    "goal_mode": null,
    "enabled": false,
    "triggers": {
      "operator": "and",
      "triggers": [
        {
          "type": "scheduled",
          "interval_seconds": 60,
          "active_start_minute": 0,
          "active_end_minute": 0
        }
      ]
    },
    "conditions": {
      "operator": "and",
      "conditions": [
        {
          "type": "feature",
          "feature_id": "presence.anyone_home",
          "operator": "equals",
          "value": false
        },
        {
          "type": "feature",
          "feature_id": "presence.away_minutes",
          "operator": "greater_or_equal",
          "value": 10
        },
        {
          "type": "feature",
          "feature_id": "lights.any_on",
          "operator": "equals",
          "value": true
        },
        {
          "type": "feature",
          "feature_id": "robot.cleaning",
          "operator": "equals",
          "value": false
        }
      ]
    },
    "actions": [
      {
        "type": "plugin_command",
        "plugin": "lights",
        "route": "actions/all_off",
        "payload": {},
        "impact_level": "Low"
      }
    ],
    "cooldown_seconds": 300,
    "trusted": null,
    "skip_if_same_mode": null,
    "auto_created": null,
    "last_executed_at": null,
    "execution_count": 0,
    "created_at": "+002026-10-13T16:30:00.000000000Z",
    "updated_at": "+002026-10-13T16:30:00.000000000Z",
