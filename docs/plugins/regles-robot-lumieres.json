  "auto_lum_absence": {
    "id": "auto_lum_absence",
    "name": "🌙 Personne à la maison : tout éteindre",
    "description": "Quatre conditions, et chacune a sa raison : personne à la maison, absence SOUTENUE de 10 minutes (un Wi-Fi qui décroche n'éteint pas la maison), au moins une lampe joignable allumée (sinon la règle tourne à vide toutes les minutes), et le robot pas en nettoyage (sinon elle éteint au fur et à mesure les pièces qu'il vient d'allumer, et les lampes clignotent pendant tout son tour). ATTENTION : elle ne vaut que ce que vaut la liste des appareils suivis du plugin freebox. Le 15/10/2026 un seul téléphone y était déclaré et les lumières s'éteignaient toutes les 5 minutes alors que quelqu'un était là. Ajouter tout nouveau téléphone dans le widget Freebox → ⚙️ Gérer.",
    "category": "maison",
    "goal_mode": null,
    "enabled": true,
    "triggers": {
      "operator": "and",
      "triggers": [
        {
          "type": "scheduled",
          "interval_seconds": 60,
          "active_start_minute": 0,
          "active_end_minute": 0
        }
      ]
    },
    "conditions": {
      "operator": "and",
      "conditions": [
        {
          "type": "feature",
          "feature_id": "presence.anyone_home",
          "operator": "equals",
          "value": false
        },
        {
          "type": "feature",
          "feature_id": "presence.away_minutes",
          "operator": "greater_or_equal",
          "value": 10
        },
        {
          "type": "feature",
          "feature_id": "lights.any_on",
          "operator": "equals",
          "value": true
        },
        {
          "type": "feature",
          "feature_id": "robot.cleaning",
          "operator": "equals",
          "value": false
        }
      ]
    },
    "actions": [
      {
        "type": "plugin_command",
        "plugin": "lights",
        "route": "actions/all_off",
        "payload": {},
        "impact_level": "Low"
      }
    ],
    "cooldown_seconds": 300,
    "trusted": null,
    "skip_if_same_mode": null,
    "auto_created": null,
    "last_executed_at": null,
    "execution_count": 0,
