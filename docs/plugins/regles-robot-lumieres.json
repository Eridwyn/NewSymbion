{
  "auto_robot_lum_salon": {
    "id": "auto_robot_lum_salon",
    "name": "🧹→💡 Salon : allumer quand le robot y passe",
    "description": "Le robot change de zone → si (1) il est bien EN NETTOYAGE et (2) la zone où il se trouve couvre « salon », allume les lampes de cette pièce. La zone « Salle de séjour » de la carte couvre plusieurs pièces au sens des lampes, d'où la condition sur robot.rooms plutôt que sur le nom de zone. Le payload d'une action étant statique, il faut une règle par pièce.",
    "category": "maison",
    "goal_mode": null,
    "enabled": true,
    "triggers": {
      "operator": "and",
      "triggers": [
        {
          "type": "custom",
          "plugin_name": "robot",
          "trigger_type": "zone_changed",
          "config": {}
        }
      ]
    },
    "conditions": {
      "operator": "and",
      "conditions": [
        {
          "type": "feature",
          "feature_id": "robot.cleaning",
          "operator": "equals",
          "value": true
        },
        {
          "type": "feature",
          "feature_id": "robot.rooms",
          "operator": "contains",
          "value": "salon"
        }
      ]
    },
    "actions": [
      {
        "type": "plugin_command",
        "plugin": "lights",
        "route": "actions/room_on",
        "payload": {
          "room": "salon"
        },
        "impact_level": "Low"
      }
    ],
    "cooldown_seconds": 10,
    "trusted": null,
    "skip_if_same_mode": null,
    "auto_created": null,
    "last_executed_at": null,
    "execution_count": 0,
    "created_at": "+002026-10-13T15:45:00.000000000Z",
    "updated_at": "+002026-10-13T15:45:00.000000000Z",
    "deleted_at": null
  },
