# Symbion Kernel - Required Environment Variables
# Copy this file to .env and fill in your values
# The kernel will REFUSE to start if these are not set.

# [REQUIRED] JWT Secret for authentication (min 32 chars recommended)
# Generate with: openssl rand -hex 32
SYMBION_JWT_SECRET=your-secure-jwt-secret-here-min-32-chars

# [REQUIRED] API Key for WebSocket auth and legacy compatibility
# Generate with: openssl rand -hex 16
SYMBION_API_KEY=your-secure-api-key-here

# [OPTIONAL] MQTT Broker address (default: 127.0.0.1:1883)
# SYMBION_MQTT_BROKER=127.0.0.1:1883
